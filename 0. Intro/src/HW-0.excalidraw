      "type": "text",
      "x": 1523.5426283033844,
      "y": 53.05944887300291,
      "width": 924.67919921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
